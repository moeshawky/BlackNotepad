<UserControl x:Class="Savaged.BlackNotepad.Views.Controls.LineNumbersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="50">
    <Border Background="{DynamicResource StandOutBackgroundBrush}"
            BorderBrush="{DynamicResource MainBackgroundBrush}"
            BorderThickness="0,0,1,0">
        <ScrollViewer Name="LineNumberScrollViewer"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock Name="LineNumberTextBlock"
                       FontFamily="{Binding ViewState.SelectedFontFamily.Key,
                                   RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="{Binding ViewState.SelectedFontZoom.FontSize,
                                   RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="Gray"
                       TextAlignment="Right"
                       Padding="5,0,5,0"
                       LineHeight="{Binding ViewState.SelectedFontZoom.FontSize,
                                     RelativeSource={RelativeSource AncestorType=Window}}"
                       Text="1"/>
        </ScrollViewer>
    </Border>
</UserControl>
