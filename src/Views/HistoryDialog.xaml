<local:Dialog x:Class="Savaged.BlackNotepad.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Savaged.BlackNotepad.Views"
        xmlns:controls="clr-namespace:Savaged.BlackNotepad.Views.Controls"
        mc:Ignorable="d"
        Title="Previous Versions"
        Height="450" Width="680"
        MinHeight="350" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource StandOutBackgroundBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseCommandExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="Close" Key="Esc" />
    </Window.InputBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Versions list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,5" FontWeight="SemiBold" Text="Revisions:" />
                <ListView ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Date" Width="120" DisplayMemberBinding="{Binding DisplayDate}" />
                            <GridViewColumn Header="Reason" Width="85" DisplayMemberBinding="{Binding DisplayReason}" />
                            <GridViewColumn Header="Size" Width="55" DisplayMemberBinding="{Binding DisplaySize}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- Content preview -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,5" FontWeight="SemiBold" Text="Preview:" />
                <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas, Courier New, monospace"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="RestoreButton"
                    Content="Restore"
                    Width="75" Height="24"
                    IsDefault="True"
                    IsEnabled="{Binding IsActionEnabled}"
                    Click="OnRestoreButtonClick" />
            <controls:CancelButtonControl Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</local:Dialog>
